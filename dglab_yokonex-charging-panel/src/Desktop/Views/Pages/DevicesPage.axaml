<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChargingPanel.Desktop.Views.Pages.DevicesPage">

    <ScrollViewer>
        <StackPanel Spacing="20">

            <!-- 设备目录 -->
            <Border Background="#1F2B3E" CornerRadius="16" Padding="0">
                <StackPanel>
                    <Border CornerRadius="16,16,0,0" Padding="24,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#172033" />
                                <GradientStop Offset="1" Color="#1C2840" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Background="#0EA5E920" CornerRadius="12" Padding="12" Margin="0,0,16,0">
                                <TextBlock Text="🗂" FontSize="20" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="设备目录" FontWeight="Bold" Foreground="White" FontSize="18" />
                                <TextBlock Text="厂商中立的能力模型清单" Foreground="#9AB0C8" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="刷新目录" Padding="12,8" CornerRadius="8"
                                    Background="#0EA5E9" Foreground="White" Click="OnRefreshCatalogClick" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="24">
                        <ListBox x:Name="CatalogList" MinHeight="120" Background="#172033" BorderBrush="#2B3B55"
                                 BorderThickness="1" CornerRadius="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="8,6">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#E6EDF7" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Id}" Foreground="#9AB0C8" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 设备发现 -->
            <Border Background="#1F2B3E" CornerRadius="16" Padding="0">
                <StackPanel>
                    <Border CornerRadius="16,16,0,0" Padding="24,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#172033" />
                                <GradientStop Offset="1" Color="#1C2840" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Background="#10B98120" CornerRadius="12" Padding="12" Margin="0,0,16,0">
                                <TextBlock Text="📡" FontSize="20" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="设备发现" FontWeight="Bold" Foreground="White" FontSize="18" />
                                <TextBlock Text="输入设备广播名称，经目录匹配后注册实例" Foreground="#9AB0C8" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="24" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="DiscoveryNameInput" Watermark="例如 47L121000"
                                     Background="#172033" Foreground="White" BorderBrush="#314764"
                                     CornerRadius="10" Padding="14,12" FontSize="14" />
                            <Button Grid.Column="1" Content="发现" Padding="16,8" CornerRadius="8"
                                    Background="#10B981" Foreground="White" Click="OnDiscoverClick" />
                        </Grid>
                        <ListBox x:Name="DiscoveryResultsPanel" MinHeight="80" Background="#172033"
                                 BorderBrush="#2B3B55" BorderThickness="1" CornerRadius="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="8,6">
                                        <TextBlock Text="{Binding Title}" Foreground="#E6EDF7" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#9AB0C8" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 已添加设备 -->
            <Border Background="#1F2B3E" CornerRadius="16" Padding="0">
                <StackPanel>
                    <Border CornerRadius="16,16,0,0" Padding="24,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#172033" />
                                <GradientStop Offset="1" Color="#1C2840" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Background="#10B98120" CornerRadius="12" Padding="12" Margin="0,0,16,0">
                                <TextBlock Text="📱" FontSize="20" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="已添加设备" FontWeight="Bold" Foreground="White" FontSize="18" />
                                <TextBlock Text="已注册的设备实例快照" Foreground="#9AB0C8" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="24" Spacing="12">
                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="#9AB0C8" FontSize="12" />
                        <ListBox x:Name="DeviceListPanel" MinHeight="80" Background="#172033"
                                 BorderBrush="#2B3B55" BorderThickness="1" CornerRadius="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="8,6">
                                        <TextBlock Text="{Binding IdText}" Foreground="#E6EDF7" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="#9AB0C8" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoDevicesHint" Text="暂无设备" Foreground="#9AB0C8" FontSize="13"
                                   HorizontalAlignment="Center" IsVisible="True" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
