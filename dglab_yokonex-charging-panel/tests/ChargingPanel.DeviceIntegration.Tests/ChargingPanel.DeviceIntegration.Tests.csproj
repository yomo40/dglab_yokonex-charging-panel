    <ProjectReference Include="..\..\src\Vendor.DGLab\ChargingPanel.Vendor.DGLab.csproj" />
    <ProjectReference Include="..\..\src\Vendor.Yokonex\ChargingPanel.Vendor.Yokonex.csproj" />
